    sInterval:50,bSpeed:4.8,bCount:5,phase2HP:45,
    move(b){
      const t=gameFrame*.007*(b.phase2?2.2:1);
      b.tx=canvas.width/2+Math.cos(t)*canvas.width*.32;
      b.ty=canvas.height/2+Math.sin(t)*canvas.height*.28;
      b.x+=(b.tx-b.x)*.025;b.y+=(b.ty-b.y)*.025;
    },
    drawExtra(b){
      ctx.save();ctx.strokeStyle=b.color;ctx.lineWidth=1.5;ctx.globalAlpha=.38;
      for(let i=0;i<5;i++){
        const a=(i/5)*Math.PI*2+gameFrame*.012;
        ctx.beginPath();
        ctx.moveTo(b.x+Math.cos(a)*b.r*.5,b.y+Math.sin(a)*b.r*.5);
        ctx.lineTo(b.x+Math.cos(a+.45)*(b.r+14),b.y+Math.sin(a+.45)*(b.r+14));
        ctx.stroke();
      }
      ctx.restore();
    }
  },
  'NULL-KING':{
    hp:160,r:68,color:'#cc00ff',pts:7000,
    sInterval:28,bSpeed:4.2,bCount:8,phase2HP:80,
    move(b){
      if(b.phase2&&gameFrame%150===0){
        const p=edgePos();b.x=p.x;b.y=p.y;
        ring(b.x,b.y,'#cc00ff',28,10,50);
        burst(b.x,b.y,'#cc00ff',28,9,40,5,0,'circle');
      }
      const a=Math.atan2(player.y-b.y,player.x-b.x);
      b.x+=Math.cos(a)*(b.phase2?2.2:1.4);
      b.y+=Math.sin(a)*(b.phase2?2.2:1.4);
    },
    drawExtra(b){
      ctx.save();ctx.strokeStyle=b.color;ctx.lineWidth=1;ctx.globalAlpha=.22;
      for(let i=0;i<4;i++){
        const a=gameFrame*.012+i*Math.PI/2,d=b.r+8+i*9;
        ctx.save();ctx.translate(b.x,b.y);ctx.rotate(a);
        ctx.strokeRect(-d/2,-d/2,d,d);ctx.restore();
      }
      ctx.restore();
    }
  },
  'VOID-MOTHER':{
    hp:250,r:78,color:'#ff0066',pts:14000,
