// ═══ PARTICLES ════════════════════════════════
function burst(x,y,color,n,spd,life,sz,grav=.08,shape='rect'){
  for(let i=0;i<n;i++){
    const a=Math.random()*Math.PI*2,s=Math.random()*spd;
    particles.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s,life,maxLife:life,
      size:sz+Math.random()*3,color,grav,shape});
  }
}
function ring(x,y,color,n,spd,life){
  for(let i=0;i<n;i++){
    const a=(i/n)*Math.PI*2;
    particles.push({x,y,vx:Math.cos(a)*spd,vy:Math.sin(a)*spd,life,maxLife:life,size:3,color,grav:0,shape:'circle'});
  }
}

// ═══ SHOOTING ═════════════════════════════════
function shoot(tx,ty){
  if(shootCD>0)return;
  const a=Math.atan2(ty-player.y,tx-player.x);
  projectiles.push({x:player.x,y:player.y,vx:Math.cos(a)*10.5,vy:Math.sin(a)*10.5,life:85,r:5,fromPlayer:true});
  burst(player.x,player.y,'#ff00ff',5,3,15,2,0,'circle');
  shootCD=10;
}

// ═══ ENEMY FACTORY ════════════════════════════
function edgePos(){
  const s=Math.random()*4|0;
  if(s===0)return{x:-40,y:Math.random()*canvas.height};
  if(s===1)return{x:canvas.width+40,y:Math.random()*canvas.height};
  if(s===2)return{x:Math.random()*canvas.width,y:-40};
  return{x:Math.random()*canvas.width,y:canvas.height+40};
}
function mkEnemy(type){
  const p=edgePos(),spd=1.15+level*.075;
  const e={...p,type,hp:1,maxHP:1,speed:spd,color:'#00eeff',pts:80,r:14,sTimer:0};
  switch(type){
    case 'fast':    e.r=10;e.speed=spd*1.85;e.color='#ffee00';e.pts=130;break;
    case 'tank':    e.r=28;e.hp=4+Math.floor(level*.5);e.maxHP=e.hp;e.speed=spd*.55;e.color='#cc00ff';e.pts=280;break;
    case 'sniper':  e.r=12;e.hp=2;e.maxHP=2;e.speed=spd*.55;e.color='#ff6600';e.pts=210;e.sTimer=70;break;
    case 'splitter':e.r=22;e.hp=3;e.maxHP=3;e.speed=spd*.85;e.color='#ff00aa';e.pts=320;e.children=3;break;
    case 'shield':  e.r=16;e.hp=3;e.maxHP=3;e.speed=spd*.9;e.color='#44ffcc';e.pts=240;e.shielded=true;break;
    case 'swarm':   e.r=8;e.speed=spd*1.4;e.color='#ff9900';e.pts=60;break;
  }
  return e;
}
function spawnWave(){
  const pools=[
    ['basic'],
    ['basic','basic','fast'],
    ['basic','fast','tank'],
    ['basic','fast','tank','sniper'],
    ['basic','fast','tank','sniper','splitter'],
    ['fast','tank','sniper','splitter','shield'],
    ['fast','tank','sniper','splitter','shield','swarm'],
  ];
  const pool=pools[Math.min(level-1,pools.length-1)];
  const n=Math.min(2+Math.floor(level*.5),9);
  for(let i=0;i<n;i++) enemies.push(mkEnemy(pool[Math.random()*pool.length|0]));
}

