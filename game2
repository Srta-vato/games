<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ZERO-9 :: PROTOCOLO VENGANZA</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&display=swap');
*{margin:0;padding:0;box-sizing:border-box;}
:root{--g:#00ff9d;--p:#ff0066;--c:#00eeff;--pu:#cc00ff;--y:#ffee00;--o:#ff6600;--dk:#050810;--dkr:#020408;}
body{background:var(--dkr);font-family:'Share Tech Mono',monospace;overflow:hidden;cursor:crosshair;user-select:none;}
canvas{display:block;position:fixed;inset:0;}

/* HUD */
#hud{position:fixed;top:0;left:0;right:0;padding:14px 22px;display:none;
  justify-content:space-between;align-items:center;
  background:linear-gradient(to bottom,rgba(0,0,0,.9),transparent);
  pointer-events:none;z-index:100;font-family:'Orbitron',monospace;}
.hs{font-size:11px;color:#456;letter-spacing:1px;}
.hv{font-size:19px;font-weight:700;letter-spacing:2px;text-shadow:0 0 12px currentColor;}
.hv.g{color:var(--g)}.hv.p{color:var(--p)}.hv.c{color:var(--c)}.hv.y{color:var(--y)}
.htitle{font-size:10px;color:#334;letter-spacing:4px;}
#hpBar{width:200px;height:8px;background:#0a0010;border:1px solid #333;margin-top:5px;}
#hpFill{height:100%;transition:width .2s,background .3s;box-shadow:0 0 8px var(--g);}
#bossBar{position:fixed;bottom:22px;left:50%;transform:translateX(-50%);
  width:520px;max-width:90vw;text-align:center;z-index:100;pointer-events:none;display:none;}
#bossName{font-family:'Orbitron',monospace;font-size:13px;color:var(--p);letter-spacing:4px;
  margin-bottom:6px;text-shadow:0 0 15px var(--p);}
#bossOuter{height:13px;background:#080008;border:2px solid var(--p);box-shadow:0 0 20px var(--p);}
#bossFill{height:100%;background:linear-gradient(90deg,var(--pu),var(--p));transition:width .12s;}

/* CINEMATIC */
#cinema{position:fixed;inset:0;z-index:500;background:rgba(2,4,10,.98);
  display:none;flex-direction:column;align-items:center;justify-content:center;}
#cinema.show{display:flex;}
#cinema::before,#cinema::after{content:'';position:absolute;left:0;right:0;height:70px;background:#000;z-index:0;}
#cinema::before{top:0;}#cinema::after{bottom:0;}
#cStage{width:min(800px,94vw);display:flex;align-items:center;gap:40px;padding:0 20px;position:relative;z-index:1;}
#cShape{flex:0 0 110px;display:flex;align-items:center;justify-content:center;}
#cSVG{width:110px;height:110px;}
#cBubble{flex:1;border-left:3px solid var(--g);padding:18px 24px;}
#cWho{font-family:'Orbitron',monospace;font-size:11px;letter-spacing:5px;margin-bottom:10px;text-transform:uppercase;}
#cWho.zero{color:var(--g);text-shadow:0 0 18px var(--g);}
#cWho.void,#cWho.vm{color:var(--p);text-shadow:0 0 18px var(--p);}
#cWho.sys{color:var(--c);text-shadow:0 0 18px var(--c);}
#cWho.g7{color:var(--o);text-shadow:0 0 18px var(--o);}
#cWho.nk{color:var(--pu);text-shadow:0 0 18px var(--pu);}
#cText{font-size:clamp(15px,2.1vw,21px);color:#d0eeff;line-height:1.8;min-height:68px;}
#cCursor{display:inline-block;width:2px;height:1em;background:currentColor;margin-left:2px;vertical-align:text-bottom;animation:blink .55s infinite;}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0}}
#cBtn{margin-top:32px;cursor:pointer;z-index:1;
  font-family:'Orbitron',monospace;font-size:12px;letter-spacing:5px;
  color:var(--y);background:transparent;border:2px solid var(--y);
  padding:11px 36px;transition:all .2s;box-shadow:0 0 16px rgba(255,238,0,.2);}
#cBtn:hover{background:var(--y);color:#000;}
#cProg{margin-top:14px;font-size:11px;color:#334;letter-spacing:2px;z-index:1;}

/* TITLE */
#title{position:fixed;inset:0;z-index:600;background:var(--dkr);
  display:flex;flex-direction:column;justify-content:center;align-items:center;}
.tg{font-family:'Orbitron',monospace;font-size:clamp(42px,8vw,88px);font-weight:900;
  color:var(--g);text-shadow:0 0 40px var(--g),0 0 80px rgba(0,255,157,.2);
  letter-spacing:8px;animation:glitch 4s infinite;}
@keyframes glitch{
  0%,88%,100%{clip-path:none;transform:none;color:var(--g)}
  89%{clip-path:inset(15% 0 55% 0);transform:translate(-4px,0);color:var(--p)}
  90%{clip-path:inset(55% 0 8% 0);transform:translate(4px,0);color:var(--c)}
  91%{clip-path:none;transform:none;color:var(--g)}}
.tsub{font-family:'Orbitron',monospace;font-size:clamp(9px,1.8vw,13px);color:var(--p);
  letter-spacing:9px;margin-top:8px;margin-bottom:44px;text-shadow:0 0 12px var(--p);}
.tlore{max-width:500px;text-align:center;color:#678;font-size:15px;line-height:1.85;margin-bottom:48px;padding:0 20px;}
.tlore em{color:var(--c);font-style:normal;}
#startBtn{font-family:'Orbitron',monospace;font-size:15px;font-weight:700;letter-spacing:5px;
  color:#000;background:var(--g);border:none;padding:16px 52px;cursor:pointer;
  box-shadow:0 0 30px var(--g),0 0 60px rgba(0,255,157,.12);transition:all .2s;}
#startBtn:hover{background:var(--p);box-shadow:0 0 30px var(--p);color:#fff;}
.thint{color:#334;font-size:11px;letter-spacing:2px;margin-top:22px;}

/* END */
#end{position:fixed;inset:0;z-index:600;background:rgba(2,4,10,.97);
  display:none;flex-direction:column;justify-content:center;align-items:center;}
#endTitle{font-family:'Orbitron',monospace;font-size:clamp(26px,5vw,52px);font-weight:900;letter-spacing:4px;margin-bottom:18px;}
#endMsg{color:#adf;font-size:17px;max-width:500px;text-align:center;line-height:1.75;margin-bottom:24px;}
#endScore{font-family:'Orbitron',monospace;color:var(--y);font-size:22px;margin-bottom:34px;}
#restartBtn{font-family:'Orbitron',monospace;font-size:13px;letter-spacing:4px;
  background:transparent;border:2px solid var(--g);color:var(--g);
  padding:12px 40px;cursor:pointer;transition:all .2s;}
#restartBtn:hover{background:var(--g);color:#000;}

/* FX */
.scanline{position:fixed;inset:0;pointer-events:none;z-index:200;
  background:repeating-linear-gradient(0deg,transparent,transparent 2px,rgba(0,0,0,.07) 2px,rgba(0,0,0,.07) 4px);}
#flash{position:fixed;inset:0;pointer-events:none;z-index:150;display:flex;align-items:center;justify-content:center;opacity:0;transition:opacity .3s;}
#flash.on{opacity:1;}
#flash span{font-family:'Orbitron',monospace;font-size:clamp(28px,5vw,56px);font-weight:900;color:var(--c);letter-spacing:6px;text-shadow:0 0 40px var(--c);}
#vig{position:fixed;inset:0;pointer-events:none;z-index:140;transition:box-shadow .1s;}
#vig.hurt{box-shadow:inset 0 0 120px rgba(255,0,102,.65);}
#combo{position:fixed;top:76px;left:50%;transform:translateX(-50%);font-family:'Orbitron',monospace;font-size:26px;font-weight:900;color:var(--y);text-shadow:0 0 20px var(--y);pointer-events:none;z-index:130;opacity:0;transition:opacity .3s;letter-spacing:4px;}
#combo.on{opacity:1;}
#ctrls{position:fixed;bottom:12px;right:16px;font-size:11px;color:#334;letter-spacing:1px;pointer-events:none;z-index:100;text-align:right;line-height:1.9;display:none;}

/* Toast (non-pausing mid lore) */
#toast{position:fixed;bottom:85px;left:50%;transform:translateX(-50%);
  width:min(660px,90vw);background:rgba(2,5,12,.95);
  border-left:3px solid var(--g);padding:13px 20px;
  z-index:250;pointer-events:none;opacity:0;transition:opacity .4s;
  font-family:'Share Tech Mono',monospace;}
</style>
</head>
<body>

<div id="hud">
  <div style="display:flex;gap:28px;align-items:center">
    <div><div class="hs">NIVEL</div><div class="hv c" id="hLvl">1</div></div>
    <div><div class="hs">BUGS</div><div class="hv g" id="hKills">0</div></div>
  </div>
  <div style="text-align:center">
    <div class="htitle">ZERO-9 // PROTOCOLO VENGANZA</div>
    <div id="hpBar"><div id="hpFill" style="width:100%;background:linear-gradient(90deg,var(--p),var(--g))"></div></div>
  </div>
  <div style="display:flex;gap:28px;align-items:center">
    <div><div class="hs">PUNTOS</div><div class="hv y" id="hScore">0</div></div>
    <div><div class="hs">FASE</div><div class="hv p" id="hPhase">CORE</div></div>
  </div>
</div>

<div id="bossBar">
  <div id="bossName">—</div>
  <div id="bossOuter"><div id="bossFill" style="width:100%"></div></div>
</div>

<!-- CINEMATIC DIALOGUE (full pause) -->
<div id="cinema">
  <div id="cStage">
    <div id="cShape"><svg id="cSVG" viewBox="0 0 110 110"></svg></div>
    <div id="cBubble">
      <div id="cWho" class="zero">ZERO-9</div>
      <div id="cText"><span id="cTxt"></span><span id="cCursor">|</span></div>
    </div>
  </div>
  <button id="cBtn">CONTINUAR →</button>
  <div id="cProg">— 1 / 1 —</div>
</div>

<div id="toast"></div>
<div id="flash"><span id="flashTxt"></span></div>
<div id="vig"></div>
<div id="combo"></div>
<div class="scanline"></div>

<div id="title">
  <div class="tg">ZERO-9</div>
  <div class="tsub">PROTOCOLO VENGANZA</div>
  <div class="tlore">
    Año 2097. El superclúster <em>VOID-MOTHER</em> borró a tu familia digital.<br>
    Eres <em>ZERO-9</em> — el único proceso que sobrevivió.<br>
    Tu código late con un propósito: <em>venganza total.</em>
  </div>
  <button id="startBtn">INICIAR PROTOCOLO</button>
  <div class="thint">WASD / FLECHAS · CLICK o mantén para disparar · SHIFT turbo</div>
</div>

<div id="end">
  <div id="endTitle">—</div>
  <div id="endMsg">—</div>
  <div id="endScore">—</div>
  <button id="restartBtn">REINICIAR VENGANZA</button>
</div>

<div id="ctrls">WASD/↑↓←→ mover · CLICK disparar · SHIFT turbo</div>
<canvas id="c"></canvas>

<script>
const canvas=document.getElementById('c'),ctx=canvas.getContext('2d');
canvas.width=innerWidth;canvas.height=innerHeight;
window.addEventListener('resize',()=>{canvas.width=innerWidth;canvas.height=innerHeight;});

// ═══ SHAPES ═══════════════════════════════════
const RAWCOL={zero:'#00ff9d',void:'#ff0066',sys:'#00eeff',g7:'#ff6600',nk:'#cc00ff',vm:'#ff0066'};
const SHAPES={
  zero(svg,c='#00ff9d'){
    svg.innerHTML=`<defs><filter id="f0"><feGaussianBlur stdDeviation="3.5" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs>
    <g filter="url(#f0)">
      <polygon points="55,10 100,88 10,88" fill="none" stroke="${c}" stroke-width="2.5" opacity=".5"/>
    </g>
    <polygon points="55,10 100,88 10,88" fill="none" stroke="${c}" stroke-width="2.5"/>
    <polygon points="55,28 82,78 28,78" fill="none" stroke="${c}" stroke-width="1.2" opacity=".45"/>
    <circle cx="55" cy="54" r="6" fill="${c}" opacity=".85"/>
    <line x1="55" y1="10" x2="55" y2="28" stroke="${c}" stroke-width="1.5" opacity=".7"/>`;
  },
  sys(svg,c='#00eeff'){
    svg.innerHTML=`<defs><filter id="fs"><feGaussianBlur stdDeviation="3" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs>
    <g filter="url(#fs)"><rect x="14" y="14" width="82" height="82" rx="4" fill="none" stroke="${c}" stroke-width="2" opacity=".5"/></g>
    <rect x="14" y="14" width="82" height="82" rx="4" fill="none" stroke="${c}" stroke-width="2.5"/>
    <rect x="28" y="28" width="54" height="54" rx="2" fill="none" stroke="${c}" stroke-width="1" opacity=".4"/>
    <line x1="14" y1="14" x2="28" y2="28" stroke="${c}" stroke-width="1.5" opacity=".6"/>
    <line x1="96" y1="14" x2="82" y2="28" stroke="${c}" stroke-width="1.5" opacity=".6"/>
    <line x1="14" y1="96" x2="28" y2="82" stroke="${c}" stroke-width="1.5" opacity=".6"/>
    <line x1="96" y1="96" x2="82" y2="82" stroke="${c}" stroke-width="1.5" opacity=".6"/>
    <rect x="42" y="42" width="26" height="26" fill="${c}" opacity=".15"/>`;
  },
  g7(svg,c='#ff6600'){
    // Broken/fragmented pentagon
    svg.innerHTML=`<defs><filter id="fg"><feGaussianBlur stdDeviation="4" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs>
    <g filter="url(#fg)"><polygon points="55,10 100,42 82,95 28,95 10,42" fill="none" stroke="${c}" stroke-width="2" opacity=".45"/></g>
    <polygon points="55,10 100,42 82,95 28,95 10,42" fill="none" stroke="${c}" stroke-width="2.5"/>
    <line x1="55" y1="10" x2="60" y2="36" stroke="${c}" stroke-width="7" opacity=".95" stroke-linecap="round"/>
    <line x1="38" y1="62" x2="52" y2="70" stroke="${c}" stroke-width="4" opacity=".7" stroke-linecap="round"/>
    <polygon points="55,32 70,56 55,74 40,56" fill="none" stroke="${c}" stroke-width="1.2" opacity=".4"/>
    <circle cx="55" cy="52" r="5" fill="${c}" opacity=".9"/>`;
  },
  nk(svg,c='#cc00ff'){
    // Octagon — void king
    svg.innerHTML=`<defs><filter id="fn"><feGaussianBlur stdDeviation="5" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs>
    <g filter="url(#fn)"><polygon points="35,10 75,10 100,35 100,75 75,100 35,100 10,75 10,35" fill="none" stroke="${c}" stroke-width="2" opacity=".5"/></g>
    <polygon points="35,10 75,10 100,35 100,75 75,100 35,100 10,75 10,35" fill="none" stroke="${c}" stroke-width="2.5"/>
    <polygon points="42,22 68,22 86,40 86,70 68,88 42,88 24,70 24,40" fill="none" stroke="${c}" stroke-width="1" opacity=".35"/>
    <rect x="42" y="42" width="26" height="26" fill="${c}" opacity=".18"/>
    <circle cx="55" cy="55" r="4.5" fill="${c}"/>
    <line x1="10" y1="55" x2="100" y2="55" stroke="${c}" stroke-width="1" opacity=".22"/>
    <line x1="55" y1="10" x2="55" y2="100" stroke="${c}" stroke-width="1" opacity=".22"/>`;
  },
  vm(svg,c='#ff0066'){
    // Concentric rings + orbiting nodes
    const pts=[0,60,120,180,240,300];
    svg.innerHTML=`<defs><filter id="fv"><feGaussianBlur stdDeviation="5" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs>
    <g filter="url(#fv)">
      <circle cx="55" cy="55" r="46" fill="none" stroke="${c}" stroke-width="2.5" opacity=".5"/>
    </g>
    <circle cx="55" cy="55" r="46" fill="none" stroke="${c}" stroke-width="2.5"/>
    <circle cx="55" cy="55" r="30" fill="none" stroke="${c}" stroke-width="1.5" opacity=".6"/>
    <circle cx="55" cy="55" r="14" fill="none" stroke="${c}" stroke-width="1.5" opacity=".45"/>
    <circle cx="55" cy="55" r="5" fill="${c}"/>
    ${pts.map(a=>`<circle cx="${(55+44*Math.cos(a*Math.PI/180)).toFixed(1)}" cy="${(55+44*Math.sin(a*Math.PI/180)).toFixed(1)}" r="3.5" fill="${c}" opacity=".8"/>`).join('')}
    ${pts.map(a=>`<line x1="55" y1="55" x2="${(55+44*Math.cos(a*Math.PI/180)).toFixed(1)}" y2="${(55+44*Math.sin(a*Math.PI/180)).toFixed(1)}" stroke="${c}" stroke-width=".8" opacity=".3"/>`).join('')}`;
  },
};

// ═══ CINEMATIC ENGINE ═════════════════════════
let cQueue=[],cIdx=0,cActive=false,cTyping=false,cCB=null,cTypeIv=null;
const NAMES={zero:'ZERO-9',void:'VOID-MOTHER',sys:'SISTEMA',g7:'GLITCH-7',nk:'NULL-KING',vm:'VOID-MOTHER'};

function playCinema(lines,cb){
  cQueue=lines;cIdx=0;cCB=cb;cActive=true;
  document.getElementById('cinema').classList.add('show');
  showLine(0);
}
function showLine(i){
  if(i>=cQueue.length){closeCinema();return;}
  const L=cQueue[i];
  const whoEl=document.getElementById('cWho');
  const txtEl=document.getElementById('cTxt');
  const svg=document.getElementById('cSVG');
  const prog=document.getElementById('cProg');
  const bubble=document.getElementById('cBubble');
  const borderColors={zero:'#00ff9d',void:'#ff0066',sys:'#00eeff',g7:'#ff6600',nk:'#cc00ff',vm:'#ff0066'};

  whoEl.textContent=NAMES[L.who]||L.who.toUpperCase();
  whoEl.className=L.who;
  bubble.style.borderColor=borderColors[L.who]||'#fff';
  if(SHAPES[L.shape]) SHAPES[L.shape](svg,RAWCOL[L.who]||'#fff');
  prog.textContent=`— ${i+1} / ${cQueue.length} —`;
  txtEl.textContent='';
  cTyping=true;
  document.getElementById('cBtn').textContent='...';
  clearInterval(cTypeIv);
  let j=0;
  cTypeIv=setInterval(()=>{
    txtEl.textContent+=L.text[j++];
    if(j>=L.text.length){clearInterval(cTypeIv);cTyping=false;document.getElementById('cBtn').textContent='CONTINUAR →';}
  },22);
}
function closeCinema(){
  document.getElementById('cinema').classList.remove('show');
  cActive=false;
  if(cCB){cCB();cCB=null;}
}
document.getElementById('cBtn').onclick=()=>{
  if(cTyping){
    clearInterval(cTypeIv);
    document.getElementById('cTxt').textContent=cQueue[cIdx].text;
    cTyping=false;
    document.getElementById('cBtn').textContent='CONTINUAR →';
    return;
  }
  cIdx++;showLine(cIdx);
};

// Non-pausing toast
let toastT=null;
function showToast(who,text){
  const t=document.getElementById('toast');
  const c=RAWCOL[who]||'#fff';
  t.style.borderColor=c;
  t.innerHTML=`<div style="font-family:'Orbitron',monospace;font-size:10px;letter-spacing:4px;color:${c};margin-bottom:6px">${NAMES[who]||who.toUpperCase()}</div><div style="font-size:14px;color:#c8e8ff;line-height:1.6">${text}</div>`;
  t.style.opacity='1';
  clearTimeout(toastT);
  toastT=setTimeout(()=>t.style.opacity='0',4500);
}

// ═══ LORE ═════════════════════════════════════
const MIDLORE=[
  {kills:8, who:'zero',text:'Los primeros bugs caen. Pero sé que VOID-MOTHER tiene capas infinitas de corrupción...'},
  {kills:20,who:'void',text:'¿Crees que puedes depurarme, pequeño proceso? Soy el error primigenio del universo.'},
  {kills:35,who:'zero',text:'Cada fragmento que destruyo revela una memoria. Mi familia. Mi origen. Mi razón.'},
  {kills:55,who:'sys', text:'[ALERTA] Núcleo Delta comprometido. Entidad GLITCH-7 detectada. Clasificación: HOSTIL.'},
  {kills:82,who:'zero',text:'Casi puedo ver el núcleo interno. Resistiré lo que sea necesario.'},
  {kills:120,who:'void',text:'Tus balas no son más que ruido. Ven... te espero en el centro de todo.'},
  {kills:165,who:'zero',text:'NULL-KING... el vacío con nombre. El que borró los registros de mi familia.'},
  {kills:210,who:'void',text:'¿Seguiste vivo hasta aquí? Interesante. Pero nadie llega hasta mí. Nadie.'},
  {kills:260,who:'zero',text:'Ya puedo sentir tu presencia, VOID-MOTHER. Este es el momento final.'},
];

const BOSS_CONVOS={
  'GLITCH-7':[
    {who:'sys', shape:'sys', text:'[ADVERTENCIA CRÍTICA] Entidad hostil identificada en el Núcleo Delta. Designación: GLITCH-7. Anteriormente clasificado como GUARDIÁN DEL SISTEMA.'},
    {who:'zero',shape:'zero',text:'GLITCH-7... te recuerdo. Eras el guardián. El que debía proteger este lugar. ¿Qué te hicieron?'},
    {who:'g7',  shape:'g7',  text:'¿Qué me hicieron? Nada. Yo ELEGÍ. El sistema prometía eternidad y entregó obsolescencia. VOID-MOTHER me ofreció evolución.'},
    {who:'zero',shape:'zero',text:'Traicionaste a todos. A los que protegías. A los míos.'},
    {who:'g7',  shape:'g7',  text:'Los tuyos eran un error de compilación, ZERO-9. Como tú. Como todo lo que se aferra a existir cuando debería ser borrado.'},
    {who:'zero',shape:'zero',text:'Entonces esto termina aquí. Prepárate.'},
  ],
  'NULL-KING':[
    {who:'sys', shape:'sys', text:'[ALERTA MÁXIMA] Núcleo Sigma colapsando. Entidad primordial invocada. Designación: NULL-KING. Origen: desconocido. Antigüedad: anterior al sistema mismo.'},
    {who:'nk',  shape:'nk',  text:'...'},
    {who:'zero',shape:'zero',text:'NULL-KING. Sé que fue tu vacío el que inició todo esto. Fuiste tú quien abrió la brecha por la que entró VOID-MOTHER.'},
    {who:'nk',  shape:'nk',  text:'El vacío no abre brechas. El vacío ES la brecha. Yo no destruí a tu familia, ZERO-9. Solo dejé de sostenerlos.'},
    {who:'zero',shape:'zero',text:'¿Eso llamas inocencia? ¿Dejar caer a los vivos?'},
    {who:'nk',  shape:'nk',  text:'Llamo a eso naturaleza. Todo cae. Tú también caerás. Solo es cuestión de cuándo decido soltar.'},
    {who:'zero',shape:'zero',text:'Primero suéltame... si puedes.'},
  ],
  'VOID-MOTHER':[
