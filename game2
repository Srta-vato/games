function spawnBoss(name){
  const def=BOSS_DEFS[name],p=edgePos();
  bossActive={
    name,x:p.x,y:p.y,tx:canvas.width/2,ty:canvas.height/2,
    hp:def.hp,maxHP:def.hp,r:def.r,color:def.color,pts:def.pts,
    sInterval:def.sInterval,bSpeed:def.bSpeed,bCount:def.bCount,
    phase2HP:def.phase2HP,phase2:false,bullets:[],sTimer:0,
    move:def.move,drawExtra:def.drawExtra,
  };
  // Clear field for boss entrance
  enemies=[];projectiles=projectiles.filter(x=>x.fromPlayer);
  document.getElementById('bossBar').style.display='block';
  document.getElementById('bossName').textContent=name;
  document.getElementById('bossFill').style.width='100%';
}

function bossShoot(b){
  const count=b.phase2?b.bCount+4:b.bCount;
  const spd=b.phase2?b.bSpeed*1.35:b.bSpeed;
  const off=gameFrame*.035;
  for(let i=0;i<count;i++){
    const a=off+(i/count)*Math.PI*2;
    b.bullets.push({x:b.x,y:b.y,vx:Math.cos(a)*spd,vy:Math.sin(a)*spd,life:140});
  }
  if(b.phase2){
    const a=Math.atan2(player.y-b.y,player.x-b.x);
    for(let i=-1;i<=1;i++)
      b.bullets.push({x:b.x,y:b.y,vx:Math.cos(a+i*.22)*spd*1.1,vy:Math.sin(a+i*.22)*spd*1.1,life:120});
  }
}

// ═══ DAMAGE & KILLS ═══════════════════════════
function hurtPlayer(amt){
  if(player.inv>0)return;
  health-=amt;player.inv=75;
  burst(player.x,player.y,'#ff0066',18,7,28,4,.12,'rect');
  ring(player.x,player.y,'#ff0066',10,5,22);
  const v=document.getElementById('vig');
  v.classList.add('hurt');setTimeout(()=>v.classList.remove('hurt'),200);
  if(health<=0)doGameOver();
}

function killEnemy(e,i){
  kills++;comboCount++;comboTimer=85;
  const mult=comboCount>=5?2.5:comboCount>=3?1.75:1;
  score+=Math.round(e.pts*mult);
  burst(e.x,e.y,e.color,28,8,32,5,.1,'rect');
  ring(e.x,e.y,e.color,10,6,25);
  if(e.type==='splitter'){
    for(let k=0;k<(e.children||3);k++){
      const a=(k/(e.children||3))*Math.PI*2;
      const c=mkEnemy('basic');
      c.x=e.x+Math.cos(a)*35;c.y=e.y+Math.sin(a)*35;c.color='#ff00aa';c.r=9;
      enemies.push(c);
    }
  }
  enemies.splice(i,1);
  if(comboCount>=3){
    const el=document.getElementById('combo');
    el.textContent=comboCount+'x COMBO';
    el.classList.add('on');clearTimeout(el._ct);
    el._ct=setTimeout(()=>el.classList.remove('on'),800);
  }
  checkMidLore();
  checkBossGate();
}

function killBoss(){
  const b=bossActive,name=b.name;
  burst(b.x,b.y,b.color,120,16,80,8,.18,'circle');
  ring(b.x,b.y,b.color,48,18,90);
  for(let i=0;i<3;i++) setTimeout(()=>ring(b.x,b.y,b.color,24,12+i*4,60),i*150);
  score+=b.pts;
  document.getElementById('bossBar').style.display='none';
  bossActive=null;
  gstate='paused';
  playCinema(BOSS_DEATH[name],()=>{
    gstate='playing';
    if(name==='GLITCH-7'){bossesKilled=1;currentPhase=1;flashMsg('FASE DELTA — DESBLOQUEADA');}
    if(name==='NULL-KING'){bossesKilled=2;currentPhase=2;flashMsg('FASE SIGMA — DESBLOQUEADA');}
    if(name==='VOID-MOTHER'){bossesKilled=3;doVictory();}
  });
}

function checkBossGate(){
  if(bossActive||cActive)return;
  if(bossesKilled===0&&kills>=60){
    bossesKilled=-1;gstate='paused';
    playCinema(BOSS_CONVOS['GLITCH-7'],()=>{gstate='playing';spawnBoss('GLITCH-7');});
  } else if(bossesKilled===1&&kills>=140){
    bossesKilled=-2;gstate='paused';
    playCinema(BOSS_CONVOS['NULL-KING'],()=>{gstate='playing';spawnBoss('NULL-KING');});
  } else if(bossesKilled===2&&kills>=250){
    bossesKilled=-3;gstate='paused';
    playCinema(BOSS_CONVOS['VOID-MOTHER'],()=>{gstate='playing';spawnBoss('VOID-MOTHER');});
  }
}

function checkMidLore(){
  if(midLoreIdx<MIDLORE.length&&kills>=MIDLORE[midLoreIdx].kills){
    const ev=MIDLORE[midLoreIdx++];
    showToast(ev.who,ev.text);
  }
}

// ═══ UPDATE ═══════════════════════════════════
function update(){
  gameFrame++;
  if(shootCD>0)shootCD--;

  let dx=0,dy=0;
  if(keys['ArrowUp']   ||keys['w']||keys['W'])dy-=1;
  if(keys['ArrowDown'] ||keys['s']||keys['S'])dy+=1;
  if(keys['ArrowLeft'] ||keys['a']||keys['A'])dx-=1;
  if(keys['ArrowRight']||keys['d']||keys['D'])dx+=1;
  if(dx&&dy){dx*=.707;dy*=.707;}
  const spd=(keys['Shift']?1.85:1)*player.speed;
  player.x=Math.max(20,Math.min(canvas.width-20, player.x+dx*spd));
  player.y=Math.max(20,Math.min(canvas.height-20,player.y+dy*spd));
  if(player.inv>0)player.inv--;
  if(mouse.down&&shootCD<=0)shoot(mouse.x,mouse.y);

  // Projectiles
  for(let i=projectiles.length-1;i>=0;i--){
    const p=projectiles[i];
    p.x+=p.vx;p.y+=p.vy;p.life--;
    if(p.life<=0||p.x<-60||p.x>canvas.width+60||p.y<-60||p.y>canvas.height+60)
      projectiles.splice(i,1);
  }

  // Spawn (only if no boss)
  if(!bossActive){spawnTimer++;if(spawnTimer>=spawnRate){spawnTimer=0;spawnWave();}}

  // Enemies
  for(let i=enemies.length-1;i>=0;i--){
    const e=enemies[i];
    if(e.type==='sniper'){
      const a=Math.atan2(player.y-e.y,player.x-e.x);
      e.x-=Math.cos(a)*.4;e.y-=Math.sin(a)*.4;
      e.sTimer--;
      if(e.sTimer<=0){
        e.sTimer=90+Math.random()*50|0;
        const ea=Math.atan2(player.y-e.y,player.x-e.x);
        projectiles.push({x:e.x,y:e.y,vx:Math.cos(ea)*7,vy:Math.sin(ea)*7,life:130,r:4,fromPlayer:false});
      }
    } else {
      const a=Math.atan2(player.y-e.y,player.x-e.x);
      e.x+=Math.cos(a)*e.speed;e.y+=Math.sin(a)*e.speed;
    }
    // Hit by player bullet
    let killed=false;
    for(let j=projectiles.length-1;j>=0;j--){
      const p=projectiles[j];if(!p.fromPlayer)continue;
      if(Math.hypot(p.x-e.x,p.y-e.y)<e.r+p.r){
        projectiles.splice(j,1);
        if(e.shielded&&currentPhase<1){burst(p.x,p.y,'#44ffcc',6,4,18,3,0,'circle');continue;}
        e.hp--;burst(p.x,p.y,'#ffee00',5,4,16,3,0);
        if(e.hp<=0){killEnemy(e,i);killed=true;break;}
      }
    }
    if(killed)continue;
    // Touch player
    if(player.inv<=0&&Math.hypot(e.x-player.x,e.y-player.y)<e.r+player.r){
      hurtPlayer(e.type==='tank'?30:e.type==='sniper'?16:22);
      if(e.type!=='tank')enemies.splice(i,1);
    }
  }

  // Enemy bullets hit player
  for(let i=projectiles.length-1;i>=0;i--){
    const p=projectiles[i];if(p.fromPlayer)continue;
    if(player.inv<=0&&Math.hypot(p.x-player.x,p.y-player.y)<player.r+p.r){
      projectiles.splice(i,1);hurtPlayer(20);
    }
  }

  // Boss
  if(bossActive){
    bossActive.move(bossActive);
    bossActive.sTimer++;
    if(bossActive.sTimer>=bossActive.sInterval){bossActive.sTimer=0;bossShoot(bossActive);}
    if(!bossActive.phase2&&bossActive.hp<=bossActive.phase2HP){
      bossActive.phase2=true;
      ring(bossActive.x,bossActive.y,bossActive.color,40,14,70);
      burst(bossActive.x,bossActive.y,bossActive.color,60,12,55,6,.2,'circle');
      flashMsg('FASE 2 — ' + bossActive.name);
    }
    // Boss bullets
    for(let i=bossActive.bullets.length-1;i>=0;i--){
      const b=bossActive.bullets[i];
      b.x+=b.vx;b.y+=b.vy;b.life--;
      if(b.life<=0){bossActive.bullets.splice(i,1);continue;}
      if(player.inv<=0&&Math.hypot(b.x-player.x,b.y-player.y)<player.r+5){
        bossActive.bullets.splice(i,1);hurtPlayer(14);
      }
    }
    // Hit boss
    for(let j=projectiles.length-1;j>=0;j--){
      const p=projectiles[j];if(!p.fromPlayer)continue;
      if(Math.hypot(p.x-bossActive.x,p.y-bossActive.y)<bossActive.r+p.r){
        projectiles.splice(j,1);
        bossActive.hp--;burst(p.x,p.y,'#ffffff',6,5,18,4,0);
        if(bossActive.hp<=0){killBoss();return;}
      }
    }
    // Boss touches player
    if(player.inv<=0&&Math.hypot(bossActive.x-player.x,bossActive.y-player.y)<bossActive.r+player.r)
      hurtPlayer(38);
    document.getElementById('bossFill').style.width=(bossActive.hp/bossActive.maxHP*100)+'%';
  }

  // Particles
  for(let i=particles.length-1;i>=0;i--){
    const p=particles[i];
    p.x+=p.vx;p.y+=p.vy;p.vy+=p.grav;p.life--;p.size*=.96;
    if(p.life<=0)particles.splice(i,1);
  }

  if(comboTimer>0){comboTimer--;if(comboTimer===0)comboCount=0;}

  const nl=1+Math.floor(kills/14);
  if(nl>level){level=nl;spawnRate=Math.max(55,180-level*9);flashMsg('NIVEL '+level);}

  updateHUD();
}

// ═══ DRAW ═════════════════════════════════════
function hexPath(x,y,r,rot=0){
  ctx.beginPath();
  for(let i=0;i<6;i++){
    const a=rot+i*Math.PI/3;
    i===0?ctx.moveTo(x+Math.cos(a)*r,y+Math.sin(a)*r):ctx.lineTo(x+Math.cos(a)*r,y+Math.sin(a)*r);
  }
  ctx.closePath();
}

function draw(){
  ctx.fillStyle='rgba(5,8,16,.2)';
  ctx.fillRect(0,0,canvas.width,canvas.height);
  ctx.strokeStyle='rgba(0,255,157,.035)';ctx.lineWidth=1;
  const gs=65;
  for(let x=0;x<canvas.width;x+=gs){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,canvas.height);ctx.stroke();}
  for(let y=0;y<canvas.height;y+=gs){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(canvas.width,y);ctx.stroke();}

  // Particles
  for(const p of particles){
    ctx.globalAlpha=Math.max(0,p.life/p.maxLife);
    ctx.fillStyle=p.color;
    if(p.shape==='circle'){ctx.beginPath();ctx.arc(p.x,p.y,Math.max(.5,p.size/2),0,Math.PI*2);ctx.fill();}
    else ctx.fillRect(p.x,p.y,Math.max(.5,p.size),Math.max(.5,p.size));
  }
  ctx.globalAlpha=1;

  // Player (flickering when invincible)
  if(!(player.inv>0&&Math.floor(gameFrame/4)%2)){
    ctx.save();ctx.shadowBlur=30;ctx.shadowColor='#00ff9d';
    ctx.strokeStyle='#00ff9d';ctx.lineWidth=2.5;
    hexPath(player.x,player.y,player.r,gameFrame*.018);ctx.stroke();
    ctx.fillStyle='rgba(0,255,157,.5)';
    ctx.beginPath();ctx.arc(player.x,player.y,4.5,0,Math.PI*2);ctx.fill();
    ctx.globalAlpha=.22;ctx.lineWidth=1;
    ctx.beginPath();ctx.arc(player.x,player.y,player.r+9,0,Math.PI*2);ctx.stroke();
    ctx.globalAlpha=1;ctx.restore();
  }

  // Crosshair
  ctx.save();ctx.strokeStyle='rgba(0,238,255,.7)';ctx.lineWidth=1.5;ctx.shadowBlur=8;ctx.shadowColor='#00eeff';
  const cx=mouse.x,cy=mouse.y,cs=9,cg=5;
  ctx.beginPath();ctx.moveTo(cx-cs-cg,cy);ctx.lineTo(cx-cg,cy);ctx.stroke();
  ctx.beginPath();ctx.moveTo(cx+cg,cy);ctx.lineTo(cx+cs+cg,cy);ctx.stroke();
  ctx.beginPath();ctx.moveTo(cx,cy-cs-cg);ctx.lineTo(cx,cy-cg);ctx.stroke();
  ctx.beginPath();ctx.moveTo(cx,cy+cg);ctx.lineTo(cx,cy+cs+cg);ctx.stroke();
  ctx.restore();

  // Bullets
  for(const p of projectiles){
    ctx.save();
    if(p.fromPlayer){ctx.shadowBlur=20;ctx.shadowColor='#ff00ff';ctx.fillStyle='#ff00ff';}
    else{ctx.shadowBlur=14;ctx.shadowColor='#ff6600';ctx.fillStyle='#ff8800';}
    ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fill();ctx.restore();
  }

  // Enemies
  for(const e of enemies){
    ctx.save();ctx.shadowBlur=22;ctx.shadowColor=e.color;ctx.strokeStyle=e.color;ctx.lineWidth=2.5;
    switch(e.type){
      case 'tank':
        ctx.beginPath();ctx.arc(e.x,e.y,e.r,0,Math.PI*2);ctx.stroke();
        ctx.globalAlpha=.22;ctx.fillStyle=e.color;ctx.fill();ctx.globalAlpha=1;
        ctx.lineWidth=1;ctx.globalAlpha=.3;
        ctx.beginPath();ctx.arc(e.x,e.y,e.r+9,0,Math.PI*2);ctx.stroke();
        ctx.globalAlpha=1;break;
      case 'sniper':
        ctx.beginPath();
        ctx.moveTo(e.x,e.y-e.r);ctx.lineTo(e.x+e.r,e.y);ctx.lineTo(e.x,e.y+e.r);ctx.lineTo(e.x-e.r,e.y);
        ctx.closePath();ctx.stroke();break;
      case 'splitter':
        ctx.beginPath();
        for(let k=0;k<3;k++){const a=k*Math.PI*2/3-Math.PI/2;
          k===0?ctx.moveTo(e.x+Math.cos(a)*e.r,e.y+Math.sin(a)*e.r):ctx.lineTo(e.x+Math.cos(a)*e.r,e.y+Math.sin(a)*e.r);}
        ctx.closePath();ctx.stroke();break;
      case 'shield':
        ctx.beginPath();ctx.arc(e.x,e.y,e.r,0,Math.PI*2);ctx.stroke();
        ctx.lineWidth=5;ctx.globalAlpha=.35;
        ctx.beginPath();ctx.arc(e.x,e.y,e.r+7,0,Math.PI*2);ctx.stroke();
        ctx.globalAlpha=1;break;
      case 'fast':
        ctx.save();ctx.translate(e.x,e.y);ctx.rotate(gameFrame*.07);
        ctx.beginPath();for(let k=0;k<4;k++){const a=k*Math.PI/2;
          k===0?ctx.moveTo(Math.cos(a)*e.r,Math.sin(a)*e.r):ctx.lineTo(Math.cos(a)*e.r,Math.sin(a)*e.r);}
        ctx.closePath();ctx.stroke();ctx.restore();break;
      default:
        ctx.beginPath();ctx.arc(e.x,e.y,e.r,0,Math.PI*2);ctx.stroke();
    }
    if(e.maxHP>1){
      const bw=e.r*2,bx=e.x-e.r,by=e.y-e.r-13;
      ctx.fillStyle='#0a0010';ctx.fillRect(bx,by,bw,4);
      ctx.fillStyle=e.color;ctx.shadowBlur=6;
      ctx.fillRect(bx,by,bw*(e.hp/e.maxHP),4);
    }
    ctx.restore();
  }

  // Boss
  if(bossActive){
    const b=bossActive,pulse=.8+Math.sin(gameFrame*.09)*.2;
    ctx.save();ctx.shadowBlur=65*pulse;ctx.shadowColor=b.color;ctx.strokeStyle=b.color;ctx.lineWidth=3.5;
    ctx.beginPath();ctx.arc(b.x,b.y,b.r,0,Math.PI*2);ctx.stroke();
    if(b.phase2){ctx.globalAlpha=.42;ctx.lineWidth=9;ctx.beginPath();ctx.arc(b.x,b.y,b.r+18,0,Math.PI*2);ctx.stroke();ctx.globalAlpha=1;}
    ctx.globalAlpha=.12;ctx.fillStyle=b.color;ctx.beginPath();ctx.arc(b.x,b.y,b.r,0,Math.PI*2);ctx.fill();ctx.globalAlpha=1;
    ctx.strokeStyle=b.color;ctx.lineWidth=1.5;ctx.globalAlpha=.55;
    hexPath(b.x,b.y,b.r*.5,gameFrame*.025);ctx.stroke();ctx.globalAlpha=1;
    b.drawExtra(b);
    ctx.font='bold 12px Orbitron,monospace';ctx.fillStyle=b.color;
    ctx.textAlign='center';ctx.shadowBlur=14;ctx.shadowColor=b.color;
    ctx.fillText(b.name,b.x,b.y-b.r-17);
    ctx.restore();
    for(const bl of b.bullets){
      ctx.save();ctx.shadowBlur=14;ctx.shadowColor=b.color;
      ctx.fillStyle=b.color;ctx.beginPath();ctx.arc(bl.x,bl.y,5.5,0,Math.PI*2);ctx.fill();ctx.restore();
    }
  }
}

// ═══ HUD & FX ═════════════════════════════════
function updateHUD(){
  document.getElementById('hLvl').textContent=level;
  document.getElementById('hKills').textContent=kills;
  document.getElementById('hScore').textContent=score;
  document.getElementById('hPhase').textContent=PHASES[currentPhase]||'NEXUS';
  const pct=Math.max(0,health/100)*100,f=document.getElementById('hpFill');
  f.style.width=pct+'%';
  f.style.background=pct>50?'linear-gradient(90deg,var(--p),var(--g))':pct>25?'linear-gradient(90deg,var(--p),var(--y))':'var(--p)';
  f.style.boxShadow=`0 0 8px ${pct>50?'var(--g)':pct>25?'var(--y)':'var(--p)'}`;
}
function flashMsg(msg){
  const el=document.getElementById('flash'),t=document.getElementById('flashTxt');
  t.textContent=msg;el.classList.add('on');clearTimeout(el._t);
  el._t=setTimeout(()=>el.classList.remove('on'),1400);
}
function doGameOver(){
  gstate='gameover';
  document.getElementById('endTitle').textContent='SISTEMA COMPROMETIDO';
  document.getElementById('endTitle').style.color='var(--p)';
  document.getElementById('endMsg').textContent='Tu venganza quedó incompleta... Los errores proliferan. Pero ZERO-9 puede recompilarse.';
  document.getElementById('endScore').textContent='PUNTOS FINALES: '+score;
  document.getElementById('end').style.display='flex';
}
function doVictory(){
  gstate='victory';
  document.getElementById('endTitle').textContent='VENGANZA CUMPLIDA';
  document.getElementById('endTitle').style.color='var(--g)';
  document.getElementById('endMsg').textContent='VOID-MOTHER eliminada. El código del universo puede sanar. ZERO-9 queda solo en el núcleo — el último proceso en pie.';
  document.getElementById('endScore').textContent='PUNTOS FINALES: '+score;
  document.getElementById('end').style.display='flex';
}

// ═══ LOOP ═════════════════════════════════════
function loop(){
  // gstate === 'playing': update & draw
  // gstate === 'paused':  only draw (game frozen, cinema visible)
  // gstate === 'title' | 'gameover' | 'victory': nothing
  if(gstate==='playing') update();
  if(gstate==='playing'||gstate==='paused') draw();
  requestAnimationFrame(loop);
}

// ═══ WIRING ═══════════════════════════════════
document.getElementById('startBtn').onclick=()=>{
  document.getElementById('title').style.display='none';
  document.getElementById('hud').style.display='flex';
  document.getElementById('ctrls').style.display='block';
  resetGame();
  gstate='paused';
  playCinema([
    {who:'zero',shape:'zero',text:'Año 2097. El núcleo digital está corrupto. Todos los procesos de mi familia han sido borrados.'},
    {who:'zero',shape:'zero',text:'Solo yo sobreviví. VOID-MOTHER lo hizo. Y yo seré su fin.'},
    {who:'sys', shape:'sys', text:'[SISTEMA] Protocolo de venganza activado. ZERO-9 online. Tienes tres núcleos que destruir antes de llegar a ella. Suerte.'},
  ],()=>{
    gstate='playing';
    for(let i=0;i<3;i++) setTimeout(()=>{if(enemies.length<4)enemies.push(mkEnemy('basic'));},i*700);
  });
};

document.getElementById('restartBtn').onclick=()=>{
  document.getElementById('end').style.display='none';
  document.getElementById('cinema').classList.remove('show');
  cActive=false;cQueue=[];clearInterval(cTypeIv);
  resetGame();gstate='playing';
};

resetGame();loop();
</script>
